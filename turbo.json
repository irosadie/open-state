{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "API_PORT",
    "DATABASE_URL",
    "JWT_SECRET",
    "MCP_PORT",
    "MCP_PROVIDER_MOCK_PORT",
    "MCP_PROVIDER_MOCK_SCENARIO",
    "MCP_SECRET_STORE",
    "MCP_EGRESS_MODE",
    "MCP_EGRESS_SCHEMES",
    "MCP_EGRESS_PORTS",
    "MCP_EGRESS_ALLOWED_HOSTS",
    "MCP_EGRESS_ALLOWED_CIDRS",
    "MCP_EGRESS_ALLOW_LOCAL_DEV",
    "MCP_EGRESS_ALLOW_PRIVATE",
    "MCP_STDIO_PROFILES_JSON",
    "REDIS_URL",
    "PORT",
    "NEXT_PUBLIC_API_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:mcp": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:smoke": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
