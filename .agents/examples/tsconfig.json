{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "$/*": ["../../apps/web/*"],
      "@openstate/schemas": ["../../packages/schemas/index.ts"],
      "@openstate/schemas/*": ["../../packages/schemas/*"],
      "@openstate/types": ["../../packages/types/index.ts"],
      "@openstate/types/*": ["../../packages/types/*"],
      "@openstate/utils": ["../../packages/utils/index.ts"],
      "@openstate/utils/*": ["../../packages/utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
