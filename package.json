{
  "name": "openstate",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.3.5",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "bootstrap": "bash ./scripts/bootstrap-local.sh",
    "dev": "turbo run dev --parallel",
    "dev:stack": "bash ./scripts/compose.sh up -d",
    "dev:web": "turbo run dev --filter=@openstate/web",
    "dev:api": "turbo run dev --filter=@openstate/api",
    "dev:worker": "turbo run dev --filter=@openstate/worker",
    "stack:up": "bash ./scripts/compose.sh up -d",
    "stack:down": "bash ./scripts/compose.sh down",
    "stack:logs": "bash ./scripts/compose.sh logs -f postgres redis",
    "stack:ps": "bash ./scripts/compose.sh ps",
    "stack:reset": "bash ./scripts/compose.sh down -v",
    "session:status": "node ./scripts/start-session.mjs",
    "build": "turbo run build",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "prisma:generate": "cd apps/api && bun run prisma:generate",
    "prisma:migrate:dev": "cd apps/api && bun run prisma:migrate:dev",
    "prisma:seed": "cd apps/api && bun run prisma:seed",
    "prisma:studio": "cd apps/api && bun run prisma:studio",
    "start:web": "turbo run start --filter=@openstate/web",
    "start:api": "turbo run start --filter=@openstate/api",
    "start:worker": "turbo run start --filter=@openstate/worker",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "turbo run test:smoke",
    "test:e2e": "bash ./scripts/e2e/run.sh",
    "test:e2e:fixtures": "cd apps/api && go run ./cmd/e2e-fixtures",
    "test:e2e:fixtures:verify": "cd apps/api && go run ./cmd/e2e-fixtures --mode verify",
    "check": "bun run skills:validate && bun run lint && bun run typecheck && bun run test && bun run test:smoke && bun run build",
    "skills:create": "node .agents/scripts/create-skill.mjs",
    "skills:sync": "bun run skills:sync-registry && bun run skills:sync-claude && bun run skills:sync-opencode",
    "skills:sync-claude": "node .agents/scripts/sync-claude-skills.mjs",
    "skills:sync-opencode": "node .agents/scripts/sync-opencode-skills.mjs",
    "skills:sync-registry": "node .agents/scripts/sync-skill-registry.mjs",
    "skills:validate": "node .agents/scripts/validate-skills.mjs",
    "go:build": "cd apps/api && go build ./... && cd ../worker && go build ./...",
    "go:test": "cd apps/api && go test ./... && cd ../worker && go test ./...",
    "go:tidy": "cd apps/api && go mod tidy && cd ../worker && go mod tidy"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.6.3"
  }
}
