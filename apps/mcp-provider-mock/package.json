{
  "name": "@openstate/mcp-provider-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:curl": "bash ./test/curl-smoke.sh",
    "test:curl:doctor": "MCP_PROVIDER_MOCK_SMOKE_DOMAIN=doctor bash ./test/curl-smoke.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "typescript": "5.9.3"
  }
}
