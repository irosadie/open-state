JWT_SECRET=dev-jwt-secret-must-be-at-least-thirty-two-characters
MCP_API_KEY_PEPPER=dev-mcp-api-key-pepper-must-be-at-least-thirty-two-characters
MCP_GATEWAY_MODE=advisory
MCP_SECRET_STORE=composite
MCP_EGRESS_MODE=development
MCP_EGRESS_SCHEMES=http,https
