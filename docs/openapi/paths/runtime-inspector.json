{
  "/api/runtime/instances": {
    "get": {
      "tags": ["Runtime Inspector"],
      "summary": "List runtime instances",
      "description": "Returns tenant-scoped persisted workflow instances. Requires instance:read.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string" } },
        { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "workflowId", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "correlationKey", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } },
        { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer", "default": 20, "maximum": 100 } }
      ],
      "responses": {
        "200": { "description": "Runtime instance page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeInstanceListResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" }
      }
    }
  },
  "/api/runtime/instances/{id}": {
    "get": {
      "tags": ["Runtime Inspector"],
      "summary": "Get a runtime instance",
      "description": "Returns the tenant-scoped workflow/version, state, sanitized context, timeline, and audit correlations. Requires instance:read.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "Runtime instance detail", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeInstanceDetailResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" }
      }
    }
  },
  "/api/runtime/instances/{id}/debug-trace": {
    "get": {
      "tags": ["Runtime Inspector"],
      "summary": "Get a runtime debug trace",
      "description": "Returns only OpenState-owned sanitized trace metadata. It never calls an LLM, RAG, MCP provider, or OTLP collector. Requires debug:read.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "turnId", "in": "query", "required": false, "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "Sanitized runtime trace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeTraceResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" }
      }
    }
  }
}
