{
  "/workflows": {
    "get": {
      "tags": ["Workflow"],
      "summary": "List workflows",
      "description": "Returns the tenant-scoped workflow definitions within a project (defaults to the tenant's default project).",
      "parameters": [
        {
          "name": "X-Tenant-ID",
          "in": "header",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "projectId",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "200": {
          "description": "Tenant workflow definitions",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Workflow" }
                  }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" }
      }
    },
    "post": {
      "tags": ["Workflow"],
      "summary": "Create a workflow draft",
      "description": "Creates a workflow definition draft (status=DRAFT) scoped to the tenant.",
      "parameters": [
        {
          "name": "X-Tenant-ID",
          "in": "header",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/CreateWorkflowRequest" }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Workflow draft created",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": { "$ref": "#/components/schemas/Workflow" }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "409": { "$ref": "#/components/schemas/ConflictError" },
        "422": { "$ref": "#/components/schemas/ValidationError" }
      }
    }
  },
  "/workflows/{id}": {
    "get": {
      "tags": ["Workflow"],
      "summary": "Get a workflow",
      "description": "Returns a single tenant/project-scoped workflow definition.",
      "parameters": [
        {
          "name": "X-Tenant-ID",
          "in": "header",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "X-Project-ID",
          "in": "header",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "200": {
          "description": "Workflow found",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": { "$ref": "#/components/schemas/Workflow" }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" }
      }
    },
    "patch": {
      "tags": ["Workflow"],
      "summary": "Update a workflow draft",
      "description": "Confirms ownership of a DRAFT workflow at an expected optimistic version, bumping the version counter (PRD §31). Only DRAFT workflows are editable.",
      "parameters": [
        {
          "name": "X-Tenant-ID",
          "in": "header",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "X-Project-ID",
          "in": "header",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/UpdateWorkflowRequest" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Workflow updated",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": { "$ref": "#/components/schemas/Workflow" }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" },
        "409": { "$ref": "#/components/schemas/ConflictError" },
        "422": { "$ref": "#/components/schemas/ValidationError" }
      }
    }
  },
  "/workflows/{id}/publish": {
    "post": {
      "tags": ["Workflow"],
      "summary": "Publish a workflow version",
      "description": "Publishes a workflow definition as an immutable, current version (PRD §3.3, §9, §55, §65, §69).",
      "parameters": [
        {
          "name": "X-Tenant-ID",
          "in": "header",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "X-Project-ID",
          "in": "header",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PublishWorkflowRequest" }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Workflow version created",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": { "$ref": "#/components/schemas/WorkflowVersion" }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" },
        "409": { "$ref": "#/components/schemas/ConflictError" },
        "422": { "$ref": "#/components/schemas/ValidationError" }
      }
    }
  },
  "/workflows/{id}/versions": {
    "get": {
      "tags": ["Workflow"],
      "summary": "List workflow versions",
      "description": "Returns the immutable versions of a workflow, newest first.",
      "parameters": [
        {
          "name": "X-Tenant-ID",
          "in": "header",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "X-Project-ID",
          "in": "header",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "200": {
          "description": "Workflow versions",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/WorkflowVersion" }
                  }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" }
      }
    }
  }
}
