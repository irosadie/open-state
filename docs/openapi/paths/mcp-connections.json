{
  "/api/projects/{projectId}/mcp-connections": {
    "get": {
      "tags": ["Admin Console"],
      "summary": "List project MCP connections",
      "description": "Lists external MCP connections owned by the selected project. Credentials and protected references are never returned.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "200": { "description": "Project MCP connections", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionListResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" }
      }
    },
    "post": {
      "tags": ["Admin Console"],
      "summary": "Register a project MCP connection",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionWriteRequest" } } } },
      "responses": {
        "201": { "description": "Connection created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" },
        "409": { "$ref": "#/components/schemas/ConflictError" },
        "422": { "$ref": "#/components/schemas/ValidationError" }
      }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}": {
    "get": {
      "tags": ["Admin Console"], "summary": "Get a project MCP connection",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Connection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    },
    "patch": {
      "tags": ["Admin Console"], "summary": "Update a project MCP connection",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionWriteRequest" } } } },
      "responses": { "200": { "description": "Connection updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" }, "409": { "$ref": "#/components/schemas/ConflictError" }, "422": { "$ref": "#/components/schemas/ValidationError" } }
    },
    "delete": {
      "tags": ["Admin Console"], "summary": "Delete a project MCP connection",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Connection deleted" }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/test": {
    "post": {
      "tags": ["Admin Console"], "summary": "Test an MCP connection handshake", "description": "Establishes an MCP session only. It does not call tools/list or provider business tools.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Safe test result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/enable": {
    "post": {
      "tags": ["Admin Console"], "summary": "Enable an MCP connection",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Connection enabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/disable": {
    "post": {
      "tags": ["Admin Console"], "summary": "Disable an MCP connection",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Connection disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/diagnose": {
    "post": {
      "tags": ["Admin Console"], "summary": "Run a safe MCP connection diagnostic", "description": "Runs the bounded handshake test and updates safe health metadata. It never returns credentials or provider payloads.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Safe diagnostic result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/reset-health": {
    "post": {
      "tags": ["Admin Console"], "summary": "Reset MCP connection health", "description": "Clears circuit and failure counters without changing credentials or connection configuration.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Health reset", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/credentials/rotate": {
    "post": {
      "tags": ["Admin Console"], "summary": "Rotate a bearer credential", "description": "Stores a replacement bearer credential in the configured secret store and revokes the previous reference. The value is write-only.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["credentialValue"], "properties": { "credentialValue": { "type": "string", "writeOnly": true } } } } } },
      "responses": { "200": { "description": "Credential rotated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" }, "409": { "$ref": "#/components/schemas/ConflictError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/credentials/revoke": {
    "post": {
      "tags": ["Admin Console"], "summary": "Revoke a bearer credential", "description": "Revokes the protected secret and removes its connection reference. Subsequent gateway calls fail closed until a new credential is configured.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Credential revoked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" }, "409": { "$ref": "#/components/schemas/ConflictError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/credentials/status": {
    "get": {
      "tags": ["Admin Console"], "summary": "Get safe credential status", "description": "Returns lifecycle status only. Secret values and protected references are never returned.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "Credential status", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "object", "required": ["status", "credentialStatus", "canRotate", "canRevoke"], "properties": { "status": { "type": "string", "enum": ["configured", "missing", "revoked"] }, "credentialStatus": { "type": "string" }, "canRotate": { "type": "boolean" }, "canRevoke": { "type": "boolean" } } } } } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/oauth/start": {
    "post": {
      "tags": ["Admin Console"], "summary": "Start MCP OAuth authorization", "description": "Creates a short-lived state and PKCE transaction. Only the authorization URL and safe lifecycle metadata are returned.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "OAuth authorization URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPOAuthStartResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "409": { "$ref": "#/components/schemas/ConflictError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/oauth/callback": {
    "get": {
      "tags": ["Admin Console"], "summary": "Complete MCP OAuth authorization", "description": "Validates one-time state and PKCE, exchanges the authorization code server-side, and persists protected token references.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } },
        { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } }
      ],
      "responses": { "200": { "description": "OAuth connection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/oauth/disconnect": {
    "post": {
      "tags": ["Admin Console"], "summary": "Disconnect MCP OAuth", "description": "Revokes locally stored token artifacts and clears their references without returning token material.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "OAuth disconnected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPConnectionResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/oauth/status": {
    "get": {
      "tags": ["Admin Console"], "summary": "Get safe MCP OAuth status", "description": "Returns OAuth lifecycle status and expiry only; token artifacts and references are never returned.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": { "200": { "description": "OAuth status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPOAuthStatusResponse" } } } }, "401": { "$ref": "#/components/schemas/UnauthorizedError" }, "403": { "$ref": "#/components/schemas/ForbiddenError" }, "404": { "$ref": "#/components/schemas/NotFoundError" } }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/tools": {
    "get": {
      "tags": ["Admin Console"],
      "summary": "List the stored MCP tool catalog",
      "description": "Returns the latest sanitized tools/list catalog and discovery-run status. This endpoint reads stored metadata and never contacts or invokes the provider.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "200": { "description": "Stored tool catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPToolCatalogResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" }
      }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/tools/refresh": {
    "post": {
      "tags": ["Admin Console"],
      "summary": "Refresh an MCP tool catalog",
      "description": "Explicitly initializes the registered MCP connection and requests tools/list. It never calls a provider business tool. A failed refresh preserves the previous successful catalog.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "200": { "description": "Refreshed tool catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPToolCatalogResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" },
        "409": { "$ref": "#/components/schemas/ConflictError" },
        "500": { "$ref": "#/components/schemas/ApiError" }
      }
    }
  },
  "/api/projects/{projectId}/mcp-connections/{id}/tools/{toolName}": {
    "patch": {
      "tags": ["Admin Console"],
      "summary": "Enable or disable a discovered MCP tool",
      "description": "Updates local eligibility only. It does not call the provider and does not rewrite workflow bindings.",
      "parameters": [
        { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "toolName", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetMCPToolEnabledRequest" } } } },
      "responses": {
        "200": { "description": "Tool enablement updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPDiscoveredToolResponse" } } } },
        "401": { "$ref": "#/components/schemas/UnauthorizedError" },
        "403": { "$ref": "#/components/schemas/ForbiddenError" },
        "404": { "$ref": "#/components/schemas/NotFoundError" },
        "422": { "$ref": "#/components/schemas/ValidationError" }
      }
    }
  }
}
