{
  "/api/audit": {
    "get": {
      "tags": ["Audit"],
      "summary": "List audit entries",
      "description": "Returns a filtered, paginated view of the tenant-scoped audit trail (PRD 50), ordered newest first. Requires the audit:read permission.",
      "parameters": [
        {
          "name": "X-Tenant-ID",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "action",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "actor",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "correlationId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "from",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "format": "date-time"
          }
        },
        {
          "name": "to",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "format": "date-time"
          }
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 1
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 20,
            "maximum": 100
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Audit trail page",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditListResponse"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/schemas/UnauthorizedError"
        },
        "403": {
          "$ref": "#/components/schemas/ForbiddenError"
        }
      }
    }
  }
}
