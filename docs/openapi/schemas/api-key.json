{
  "StateMCPAPIKey": {
    "type": "object",
    "required": ["id", "tenantId", "name", "prefix", "projectIds", "scopes", "createdBy", "createdAt"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "tenantId": { "type": "string", "format": "uuid" },
      "name": { "type": "string" },
      "prefix": { "type": "string", "example": "osk_a1b2c3d4e5f6" },
      "projectIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
      "defaultProjectId": { "type": "string", "format": "uuid", "nullable": true },
      "scopes": { "type": "array", "items": { "type": "string", "enum": ["state:read", "state:write", "capability:invoke"] } },
      "expiresAt": { "type": "string", "format": "date-time", "nullable": true },
      "revokedAt": { "type": "string", "format": "date-time", "nullable": true },
      "lastUsedAt": { "type": "string", "format": "date-time", "nullable": true },
      "createdBy": { "type": "string" },
      "createdAt": { "type": "string", "format": "date-time" }
    }
  },
  "CreateStateMCPAPIKeyRequest": {
    "type": "object",
    "required": ["name", "projectIds", "scopes"],
    "properties": {
      "name": { "type": "string" },
      "projectIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } },
      "defaultProjectId": { "type": "string", "format": "uuid", "nullable": true },
      "scopes": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["state:read", "state:write", "capability:invoke"] } },
      "expiresAt": { "type": "string", "format": "date-time", "nullable": true }
    }
  },
  "CreateStateMCPAPIKeyResponse": {
    "type": "object",
    "required": ["data"],
    "properties": {
      "data": { "type": "object", "required": ["key", "apiKey"], "properties": { "key": { "type": "string", "description": "Raw secret shown only in this response." }, "apiKey": { "$ref": "#/components/schemas/StateMCPAPIKey" } } }
    }
  }
}
