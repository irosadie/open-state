{
  "format": "openstate.workflow",
  "version": 1,
  "exportedAt": "2026-08-26T18:15:15.775Z",
  "workflow": {
    "slug": "padel-court-booking",
    "name": "Padel Court Booking",
    "description": "Workflow for booking a padel court: choose location, check availability, recommend alternatives on overlap, confirm, and pay 50% down payment.",
    "schemaVersion": 1,
    "status": "DRAFT",
    "entryNodeId": "n_start",
    "nodes": [
      {
        "id": "n_start",
        "kind": "START",
        "name": "START",
        "description": "Entry point of the padel court booking workflow.",
        "requiredContext": [],
        "capabilities": [],
        "policy": {},
        "isTerminal": false,
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_select_location",
        "kind": "STATE",
        "name": "SELECT_LOCATION",
        "description": "User selects the padel branch / location.",
        "requiredContext": [],
        "capabilities": [
          "location.list"
        ],
        "instructions": "Show the list of available branches. Ask which branch the user wants if not already mentioned. Do not re-ask if it is already in context.",
        "policy": {
          "timeoutSeconds": 300,
          "onTimeout": "state.timeout"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_select_datetime",
        "kind": "STATE",
        "name": "SELECT_DATE_TIME",
        "description": "User selects the date and time to play padel (1-hour slot).",
        "requiredContext": [
          "location.id"
        ],
        "capabilities": [
          "slot.list"
        ],
        "instructions": "Ask for the desired date and time. Remind that each slot is 1 hour. If there is already a preference from prior context, just confirm it again.",
        "policy": {
          "timeoutSeconds": 300,
          "onTimeout": "state.timeout"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_check_availability",
        "kind": "DECISION",
        "name": "CHECK_AVAILABILITY",
        "description": "Check availability of the selected slot via MCP. If overlap → recommend alternatives.",
        "requiredContext": [
          "location.id",
          "booking.date",
          "booking.time_start",
          "booking.time_end"
        ],
        "capabilities": [
          "slot.check_availability"
        ],
        "instructions": "Call slot.check_availability. Do not continue without system verification. Do not trust the user's claim that a slot is available.",
        "policy": {
          "timeoutSeconds": 30,
          "onTimeout": "state.timeout",
          "retry": {
            "maxAttempts": 2,
            "backoffMs": 1000,
            "retryableEvents": [
              "capability.timeout"
            ]
          }
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_recommend_alternative",
        "kind": "STATE",
        "name": "RECOMMEND_ALTERNATIVE",
        "description": "The selected slot is not available (overlap). Show the nearest available times and/or another day.",
        "requiredContext": [
          "location.id",
          "booking.date",
          "booking.time_start",
          "slot.alternatives"
        ],
        "capabilities": [
          "slot.check_availability"
        ],
        "instructions": "Inform the user that the selected slot is not available. Offer two options: (1) the nearest available time on the same day, (2) the same slot on the next day. Present options concisely. Wait for the user's choice.",
        "policy": {
          "timeoutSeconds": 300,
          "onTimeout": "state.timeout"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_select_court",
        "kind": "STATE",
        "name": "SELECT_COURT",
        "description": "Select the court number available for the confirmed slot.",
        "requiredContext": [
          "location.id",
          "booking.date",
          "booking.time_start",
          "booking.time_end",
          "slot.available_courts"
        ],
        "capabilities": [
          "court.list"
        ],
        "instructions": "Show the list of courts available for that slot. Ask for the court preference (number/type). If only one is available, confirm directly.",
        "policy": {
          "timeoutSeconds": 180,
          "onTimeout": "state.timeout"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_confirm_booking",
        "kind": "STATE",
        "name": "CONFIRM_BOOKING",
        "description": "Show the complete booking summary including the price and the 50% down payment due.",
        "requiredContext": [
          "location.id",
          "location.name",
          "booking.date",
          "booking.time_start",
          "booking.time_end",
          "court.id",
          "court.name",
          "booking.price_total"
        ],
        "capabilities": [
          "booking.calculate_price"
        ],
        "instructions": "Show the summary: location, date, time, court, total price, and the 50% down payment due now. Ask for confirmation before proceeding to payment. Do not continue without explicit user confirmation.",
        "policy": {
          "timeoutSeconds": 300,
          "onTimeout": "state.timeout"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_payment",
        "kind": "STATE",
        "name": "PAYMENT",
        "description": "Process the 50% down payment of the total court rental price.",
        "requiredContext": [
          "booking.id",
          "booking.price_total",
          "booking.dp_amount",
          "customer.id"
        ],
        "capabilities": [
          "payment.instruction",
          "payment.create",
          "payment.status"
        ],
        "instructions": "Ask the user to pay the 50% down payment of the total price. Provide payment instructions. Wait for payment confirmation from the system (do not trust the user's claim). Verify via payment.status before transitioning.",
        "policy": {
          "timeoutSeconds": 1800,
          "onTimeout": "state.timeout",
          "retry": {
            "maxAttempts": 3,
            "backoffMs": 2000,
            "retryableEvents": [
              "payment.failed",
              "capability.timeout"
            ]
          }
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_payment_failed",
        "kind": "STATE",
        "name": "PAYMENT_FAILED",
        "description": "The down payment failed. Offer retry or cancellation.",
        "requiredContext": [
          "booking.id",
          "payment.failure_reason"
        ],
        "capabilities": [
          "payment.status"
        ],
        "instructions": "Inform the user that the payment failed along with the reason. Offer to retry or cancel the booking.",
        "policy": {
          "timeoutSeconds": 300,
          "onTimeout": "state.timeout"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_booking_confirmed",
        "kind": "END",
        "name": "BOOKING_CONFIRMED",
        "description": "Booking successfully confirmed. The 50% down payment has been received. Send voucher/e-ticket.",
        "requiredContext": [
          "booking.id",
          "payment.id"
        ],
        "capabilities": [
          "booking.confirm",
          "notification.send_ticket"
        ],
        "instructions": "Congratulate the user, show booking details, booking number, and inform them that the remaining balance is paid upon arrival at the location.",
        "policy": {},
        "isTerminal": true,
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_payment_expired",
        "kind": "END",
        "name": "PAYMENT_EXPIRED",
        "description": "The down payment time has expired. The slot is released.",
        "requiredContext": [
          "booking.id"
        ],
        "capabilities": [
          "booking.cancel",
          "slot.release"
        ],
        "instructions": "Inform the user that the payment time has expired and the slot has been released. Offer to start a new booking.",
        "policy": {},
        "isTerminal": true,
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_cancelled",
        "kind": "END",
        "name": "CANCELLED",
        "description": "Booking cancelled by the user.",
        "requiredContext": [],
        "capabilities": [
          "slot.release"
        ],
        "instructions": "Confirm the cancellation. If the slot was on hold, make sure it is released.",
        "policy": {},
        "isTerminal": true,
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "n_human_handoff",
        "kind": "END",
        "name": "HUMAN_HANDOFF",
        "description": "Payment failed 3 times. Escalate to a human agent.",
        "requiredContext": [
          "booking.id",
          "customer.id"
        ],
        "capabilities": [
          "handoff.create"
        ],
        "instructions": "Inform the user that they will be connected to an agent to help with the payment process. Stop all automatic transitions.",
        "policy": {
          "humanHandoff": {
            "enabled": true
          }
        },
        "isTerminal": true,
        "position": {
          "x": 0,
          "y": 0
        }
      }
    ],
    "transitions": [
      {
        "id": "tr_start_location",
        "sourceStateId": "n_start",
        "targetStateId": "n_select_location",
        "event": "workflow.started",
        "guards": [],
        "priority": 1
      },
      {
        "id": "tr_location_datetime",
        "sourceStateId": "n_select_location",
        "targetStateId": "n_select_datetime",
        "event": "location.selected",
        "guards": [
          {
            "id": "g1",
            "logic": "AND",
            "conditions": [
              {
                "id": "c1",
                "field": "location.id",
                "operator": "EXISTS"
              }
            ]
          }
        ],
        "priority": 1
      },
      {
        "id": "tr_datetime_check",
        "sourceStateId": "n_select_datetime",
        "targetStateId": "n_check_availability",
        "event": "datetime.selected",
        "guards": [
          {
            "id": "g2",
            "logic": "AND",
            "conditions": [
              {
                "id": "c2",
                "field": "booking.date",
                "operator": "EXISTS"
              },
              {
                "id": "c3",
                "field": "booking.time_start",
                "operator": "EXISTS"
              },
              {
                "id": "c4",
                "field": "booking.time_end",
                "operator": "EXISTS"
              }
            ]
          }
        ],
        "priority": 1
      },
      {
        "id": "tr_datetime_timeout",
        "sourceStateId": "n_select_datetime",
        "targetStateId": "n_cancelled",
        "event": "state.timeout",
        "guards": [],
        "priority": 10
      },
      {
        "id": "tr_check_available",
        "sourceStateId": "n_check_availability",
        "targetStateId": "n_select_court",
        "event": "slot.available",
        "guards": [
          {
            "id": "g3",
            "logic": "AND",
            "conditions": [
              {
                "id": "c5",
                "field": "slot.available",
                "operator": "==",
                "value": "true"
              }
            ]
          }
        ],
        "priority": 1
      },
      {
        "id": "tr_check_unavailable",
        "sourceStateId": "n_check_availability",
        "targetStateId": "n_recommend_alternative",
        "event": "slot.unavailable",
        "guards": [
          {
            "id": "g4",
            "logic": "AND",
            "conditions": [
              {
                "id": "c6",
                "field": "slot.available",
                "operator": "==",
                "value": "false"
              }
            ]
          }
        ],
        "priority": 2
      },
      {
        "id": "tr_check_timeout",
        "sourceStateId": "n_check_availability",
        "targetStateId": "n_select_datetime",
        "event": "state.timeout",
        "guards": [],
        "priority": 10
      },
      {
        "id": "tr_recommend_reselect",
        "sourceStateId": "n_recommend_alternative",
        "targetStateId": "n_check_availability",
        "event": "slot.reselected",
        "guards": [
          {
            "id": "g5",
            "logic": "AND",
            "conditions": [
              {
                "id": "c7",
                "field": "booking.date",
                "operator": "EXISTS"
              },
              {
                "id": "c8",
                "field": "booking.time_start",
                "operator": "EXISTS"
              }
            ]
          }
        ],
        "priority": 1
      },
      {
        "id": "tr_recommend_cancel",
        "sourceStateId": "n_recommend_alternative",
        "targetStateId": "n_cancelled",
        "event": "user.cancelled",
        "guards": [],
        "priority": 2
      },
      {
        "id": "tr_recommend_timeout",
        "sourceStateId": "n_recommend_alternative",
        "targetStateId": "n_cancelled",
        "event": "state.timeout",
        "guards": [],
        "priority": 10
      },
      {
        "id": "tr_court_confirm",
        "sourceStateId": "n_select_court",
        "targetStateId": "n_confirm_booking",
        "event": "court.selected",
        "guards": [
          {
            "id": "g6",
            "logic": "AND",
            "conditions": [
              {
                "id": "c9",
                "field": "court.id",
                "operator": "EXISTS"
              }
            ]
          }
        ],
        "priority": 1
      },
      {
        "id": "tr_court_cancel",
        "sourceStateId": "n_select_court",
        "targetStateId": "n_cancelled",
        "event": "user.cancelled",
        "guards": [],
        "priority": 2
      },
      {
        "id": "tr_confirm_payment",
        "sourceStateId": "n_confirm_booking",
        "targetStateId": "n_payment",
        "event": "confirm.requested",
        "guards": [
          {
            "id": "g7",
            "logic": "AND",
            "conditions": [
              {
                "id": "c10",
                "field": "booking.dp_amount",
                "operator": "EXISTS"
              },
              {
                "id": "c11",
                "field": "booking.dp_amount",
                "operator": ">",
                "value": "0"
              }
            ]
          }
        ],
        "priority": 1
      },
      {
        "id": "tr_confirm_cancel",
        "sourceStateId": "n_confirm_booking",
        "targetStateId": "n_cancelled",
        "event": "user.cancelled",
        "guards": [],
        "priority": 2
      },
      {
        "id": "tr_payment_success",
        "sourceStateId": "n_payment",
        "targetStateId": "n_booking_confirmed",
        "event": "payment.success",
        "guards": [
          {
            "id": "g8",
            "logic": "AND",
            "conditions": [
              {
                "id": "c12",
                "field": "payment.status",
                "operator": "==",
                "value": "success"
              },
              {
                "id": "c13",
                "field": "payment.amount",
                "operator": ">=",
                "value": "booking.dp_amount"
              }
            ]
          }
        ],
        "priority": 1
      },
      {
        "id": "tr_payment_failed",
        "sourceStateId": "n_payment",
        "targetStateId": "n_payment_failed",
        "event": "payment.failed",
        "guards": [
          {
            "id": "g9",
            "logic": "AND",
            "conditions": [
              {
                "id": "c14",
                "field": "payment.status",
                "operator": "==",
                "value": "failed"
              }
            ]
          }
        ],
        "priority": 2
      },
      {
        "id": "tr_payment_timeout",
        "sourceStateId": "n_payment",
        "targetStateId": "n_payment_expired",
        "event": "state.timeout",
        "guards": [],
        "priority": 10
      },
      {
        "id": "tr_payment_handoff",
        "sourceStateId": "n_payment",
        "targetStateId": "n_human_handoff",
        "event": "retry.exhausted",
        "guards": [],
        "priority": 5
      },
      {
        "id": "tr_failed_retry",
        "sourceStateId": "n_payment_failed",
        "targetStateId": "n_payment",
        "event": "retry.requested",
        "guards": [],
        "priority": 1
      },
      {
        "id": "tr_failed_cancel",
        "sourceStateId": "n_payment_failed",
        "targetStateId": "n_cancelled",
        "event": "user.cancelled",
        "guards": [],
        "priority": 2
      }
    ],
    "policy": {
      "maxDurationSeconds": 86400,
      "interruptible": "USER_REQUESTED",
      "priority": 10
    },
    "triggers": [
      {
        "event": "padel.booking.requested",
        "source": "intent"
      },
      {
        "event": "booking.padel.started",
        "source": "api"
      }
    ]
  }
}
