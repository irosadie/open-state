{
  "openapi": "3.0.3",
  "info": {
    "title": "Vibecoding Starter API",
    "version": "0.1.0",
    "description": "OpenState — Enterprise Conversation State Orchestration Platform API."
  },
  "servers": [
    {
      "url": "http://localhost:8020",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Baseline system endpoints for starter health and app info."
    }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "tags": [
          "Capability"
        ],
        "summary": "List capabilities",
        "description": "Returns the tenant-scoped capability registry, optionally filtered by provider type and status.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "MCP",
                "INTERNAL",
                "HTTP",
                "FUTURE"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE",
                "DISABLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant capability registry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Capability"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "422": {
            "$ref": "#/components/schemas/CapabilityError"
          }
        }
      },
      "post": {
        "tags": [
          "Capability"
        ],
        "summary": "Register a capability",
        "description": "Registers a capability scoped to the tenant. Secrets are never accepted or returned; only credential_reference.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCapabilityRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Capability created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Capability"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "409": {
            "$ref": "#/components/schemas/ConflictError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/capabilities/{id}": {
      "get": {
        "tags": [
          "Capability"
        ],
        "summary": "Get a capability",
        "description": "Returns a single tenant-scoped capability.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capability found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Capability"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      },
      "patch": {
        "tags": [
          "Capability"
        ],
        "summary": "Update a capability",
        "description": "Updates mutable fields of a tenant-scoped capability.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCapabilityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capability updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Capability"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Capability"
        ],
        "summary": "Disable a capability",
        "description": "Disables (removes) a tenant-scoped capability and its bindings.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capability disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      }
    },
    "/capabilities/{id}/bindings": {
      "get": {
        "tags": [
          "Capability"
        ],
        "summary": "List bindings for a capability",
        "description": "Returns the tenant-scoped bindings of a capability.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capability bindings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CapabilityBinding"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      },
      "post": {
        "tags": [
          "Capability"
        ],
        "summary": "Create a binding",
        "description": "Binds a capability to a tenant/workflow/state scope with an allow/deny permission.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBindingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Binding created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CapabilityBinding"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "409": {
            "$ref": "#/components/schemas/ConflictError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/capabilities/{id}/test": {
      "post": {
        "tags": [
          "Capability"
        ],
        "summary": "Test-invoke a capability",
        "description": "Runs a capability through the security chain in mock/sandbox mode and returns the normalized result. Never triggers live external side effects.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestInvocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock invocation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/InvocationResult"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/schemas/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/bindings/{id}": {
      "delete": {
        "tags": [
          "Capability"
        ],
        "summary": "Remove a binding",
        "description": "Removes a tenant-scoped capability binding.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Binding removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get starter app info",
        "description": "Returns baseline information about the API scaffold.",
        "responses": {
          "200": {
            "description": "Application info loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get API health status",
        "description": "Returns a simple health check payload for the API scaffold.",
        "responses": {
          "200": {
            "description": "Health status loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Capability": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "name",
          "providerType",
          "status",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Logical capability, e.g. payment.create"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "providerType": {
            "type": "string",
            "enum": [
              "MCP",
              "INTERNAL",
              "HTTP",
              "FUTURE"
            ]
          },
          "providerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputSchema": {},
          "outputSchema": {},
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "DISABLED"
            ]
          },
          "version": {
            "type": "integer"
          },
          "credentialReference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reference to a stored credential. Secret values are NEVER returned."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateCapabilityRequest": {
        "type": "object",
        "required": [
          "name",
          "providerType"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "providerType": {
            "type": "string",
            "enum": [
              "MCP",
              "INTERNAL",
              "HTTP",
              "FUTURE"
            ]
          },
          "providerId": {
            "type": "string"
          },
          "inputSchema": {},
          "outputSchema": {},
          "version": {
            "type": "integer",
            "default": 1
          },
          "credentialReference": {
            "type": "string"
          }
        }
      },
      "UpdateCapabilityRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "providerType": {
            "type": "string",
            "enum": [
              "MCP",
              "INTERNAL",
              "HTTP",
              "FUTURE"
            ]
          },
          "providerId": {
            "type": "string"
          },
          "inputSchema": {},
          "outputSchema": {},
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "DISABLED"
            ]
          },
          "version": {
            "type": "integer",
            "default": 1
          },
          "credentialReference": {
            "type": "string"
          }
        }
      },
      "CapabilityBinding": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "capabilityId",
          "scopeType",
          "scopeId",
          "permission"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "capabilityId": {
            "type": "string"
          },
          "scopeType": {
            "type": "string",
            "enum": [
              "TENANT",
              "WORKFLOW",
              "STATE"
            ]
          },
          "scopeId": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "enum": [
              "ALLOW",
              "DENY"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateBindingRequest": {
        "type": "object",
        "required": [
          "scopeType",
          "scopeId"
        ],
        "properties": {
          "scopeType": {
            "type": "string",
            "enum": [
              "TENANT",
              "WORKFLOW",
              "STATE"
            ]
          },
          "scopeId": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "enum": [
              "ALLOW",
              "DENY"
            ],
            "default": "ALLOW"
          }
        }
      },
      "TestInvocationRequest": {
        "type": "object",
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "type": "object"
          },
          "scopeId": {
            "type": "string",
            "description": "Optional workflow/state scope for binding resolution"
          }
        }
      },
      "InvocationResult": {
        "type": "object",
        "required": [
          "data",
          "fromMock"
        ],
        "properties": {
          "data": {
            "type": "object"
          },
          "fromMock": {
            "type": "boolean",
            "description": "True when executed via the mock/sandbox provider"
          },
          "durationMs": {
            "type": "integer"
          },
          "event": {
            "type": [
              "string",
              "null"
            ],
            "description": "Deterministic capability event code"
          }
        }
      },
      "CapabilityError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "TIMEOUT",
              "UNAUTHORIZED",
              "VALIDATION",
              "UNAVAILABLE",
              "BUSINESS",
              "EXTERNAL",
              "INTERNAL"
            ]
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "NotFoundError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ConflictError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "UnauthorizedError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ForbiddenError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "details": {}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "errors"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "AppInfo": {
        "type": "object",
        "required": [
          "name",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AppInfoResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AppInfo"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Health"
          }
        }
      }
    }
  }
}
