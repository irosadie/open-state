{
  "openapi": "3.0.3",
  "info": {
    "title": "Vibecoding Starter API",
    "version": "0.1.0",
    "description": "OpenState \u2014 Enterprise Conversation State Orchestration Platform API."
  },
  "servers": [
    {
      "url": "http://localhost:8020",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Baseline system endpoints for starter health and app info."
    },
    {
      "name": "Audit",
      "description": "Tenant-scoped audit trail query (PRD 50)."
    }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "tags": [
          "Capability"
        ],
        "summary": "List capabilities",
        "description": "Returns the tenant-scoped capability registry, optionally filtered by provider type and status.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "MCP",
                "INTERNAL",
                "HTTP",
                "FUTURE"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE",
                "DISABLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant capability registry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Capability"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "422": {
            "$ref": "#/components/schemas/CapabilityError"
          }
        }
      },
      "post": {
        "tags": [
          "Capability"
        ],
        "summary": "Register a capability",
        "description": "Registers a capability scoped to the tenant. Secrets are never accepted or returned; only credential_reference.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCapabilityRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Capability created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Capability"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "409": {
            "$ref": "#/components/schemas/ConflictError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/capabilities/{id}": {
      "get": {
        "tags": [
          "Capability"
        ],
        "summary": "Get a capability",
        "description": "Returns a single tenant-scoped capability.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capability found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Capability"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      },
      "patch": {
        "tags": [
          "Capability"
        ],
        "summary": "Update a capability",
        "description": "Updates mutable fields of a tenant-scoped capability.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCapabilityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capability updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Capability"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Capability"
        ],
        "summary": "Disable a capability",
        "description": "Disables (removes) a tenant-scoped capability and its bindings.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capability disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      }
    },
    "/capabilities/{id}/bindings": {
      "get": {
        "tags": [
          "Capability"
        ],
        "summary": "List bindings for a capability",
        "description": "Returns the tenant-scoped bindings of a capability.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capability bindings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CapabilityBinding"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      },
      "post": {
        "tags": [
          "Capability"
        ],
        "summary": "Create a binding",
        "description": "Binds a capability to a tenant/workflow/state scope with an allow/deny permission.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBindingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Binding created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CapabilityBinding"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "409": {
            "$ref": "#/components/schemas/ConflictError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/capabilities/{id}/test": {
      "post": {
        "tags": [
          "Capability"
        ],
        "summary": "Test-invoke a capability",
        "description": "Runs a capability through the security chain in mock/sandbox mode and returns the normalized result. Never triggers live external side effects.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestInvocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock invocation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/InvocationResult"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/schemas/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          },
          "429": {
            "description": "Rate limit exceeded (capability.rate_limited)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          }
        }
      }
    },
    "/bindings/{id}": {
      "delete": {
        "tags": [
          "Capability"
        ],
        "summary": "Remove a binding",
        "description": "Removes a tenant-scoped capability binding.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Binding removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get starter app info",
        "description": "Returns baseline information about the API scaffold.",
        "responses": {
          "200": {
            "description": "Application info loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get API health status",
        "description": "Returns a simple health check payload for the API scaffold.",
        "responses": {
          "200": {
            "description": "Health status loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/workflows": {
      "get": {
        "tags": [
          "Workflow"
        ],
        "summary": "List workflows",
        "description": "Returns the tenant-scoped workflow definitions within a project (defaults to the tenant's default project).",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant workflow definitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Workflow"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          }
        }
      },
      "post": {
        "tags": [
          "Workflow"
        ],
        "summary": "Create a workflow draft",
        "description": "Creates a workflow definition draft (status=DRAFT) scoped to the tenant.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkflowRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workflow draft created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Workflow"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "409": {
            "$ref": "#/components/schemas/ConflictError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/workflows/{id}": {
      "get": {
        "tags": [
          "Workflow"
        ],
        "summary": "Get a workflow",
        "description": "Returns a single tenant/project-scoped workflow definition.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Project-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Workflow"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      },
      "patch": {
        "tags": [
          "Workflow"
        ],
        "summary": "Update a workflow draft",
        "description": "Confirms ownership of a DRAFT workflow at an expected optimistic version, bumping the version counter (PRD \u00a731). Only DRAFT workflows are editable.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Project-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWorkflowRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workflow updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Workflow"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          },
          "409": {
            "$ref": "#/components/schemas/ConflictError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/workflows/{id}/publish": {
      "post": {
        "tags": [
          "Workflow"
        ],
        "summary": "Publish a workflow version",
        "description": "Publishes a workflow definition as an immutable, current version (PRD \u00a73.3, \u00a79, \u00a755, \u00a765, \u00a769).",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Project-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishWorkflowRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workflow version created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WorkflowVersion"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          },
          "409": {
            "$ref": "#/components/schemas/ConflictError"
          },
          "422": {
            "$ref": "#/components/schemas/ValidationError"
          }
        }
      }
    },
    "/workflows/{id}/versions": {
      "get": {
        "tags": [
          "Workflow"
        ],
        "summary": "List workflow versions",
        "description": "Returns the immutable versions of a workflow, newest first.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Project-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow versions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WorkflowVersion"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/schemas/NotFoundError"
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "List audit entries",
        "description": "Returns a filtered, paginated view of the tenant-scoped audit trail (PRD 50), ordered newest first. Requires the audit:read permission.",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resourceType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resourceId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "correlationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit trail page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/schemas/ForbiddenError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Capability": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "name",
          "providerType",
          "status",
          "version",
